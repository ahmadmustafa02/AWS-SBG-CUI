# Base URL of the serverless API (API Gateway + Lambda), without a trailing slash.
# While this is empty the site runs in "preview mode": forms validate but send
# nothing, and live features (leaderboard, certificates, photos) show their
# not-connected states instead of fake data.
NEXT_PUBLIC_API_BASE_URL=

# Public site origin, used for shareable event links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
